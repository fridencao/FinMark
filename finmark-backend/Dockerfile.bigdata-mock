FROM node:22-alpine AS base
WORKDIR /app

# Backend workspace
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY finmark-backend ./finmark-backend

# Install only the mock service + its shared deps
WORKDIR /app/finmark-backend
RUN corepack enable && corepack prepare pnpm@9 --activate
RUN pnpm install --filter bigdata-mock --frozen-lockfile

WORKDIR /app/finmark-backend/services/bigdata-mock
RUN pnpm build || true

EXPOSE 4000
CMD ["pnpm", "start"]
