DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finmark?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
JWT_SECRET="your-secret-key-change-in-production"
REPORTS_DIR="./reports"
NODE_ENV="development"

# LLM Provider (llm-gateway reads these directly)
LLM_PROVIDER=gemini             # gemini | openai (deepseek, etc.)
GEMINI_API_KEY=                 # required if LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=                 # required if LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# CRM Integration
CRM_BASE_URL=http://core-banking:8080/api
CRM_API_KEY=your-crm-api-key
CRM_TIMEOUT=5000
CRM_RETRY_ATTEMPTS=3
CRM_CACHE_TTL=300

# Big Data Platform
BIG_DATA_GRAPHQL_URL=http://bigdata:4000/graphql
BIG_DATA_API_KEY=your-bigdata-api-key
BIG_DATA_TIMEOUT=10000

# Alarm Notifications
ALARM_NOTIFY_EMAILS=ops-team@company.com,oncall@company.com
ALARM_NOTIFY_PHONES=+86-138-xxxx-xxxx

# SMTP for alarm email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alert@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=FinMark Alerts <alert@example.com>
