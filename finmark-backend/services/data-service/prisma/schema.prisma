generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String     @unique
  password  String
  name      String
  role      UserRole   @default(operator)
  status    UserStatus @default(enabled)
  lastLogin DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]

  @@map("users")
}

model Scenario {
  id              String           @id @default(uuid())
  title           String
  goal            String
  category        ScenarioCategory
  icon            String?
  color           String?
  config          Json?
  status          ScenarioStatus   @default(draft)
  complianceScore Int?
  riskLevel       String?
  isCustom        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  executions      Execution[]

  @@map("scenarios")
}

model Execution {
  id               String          @id @default(uuid())
  scenarioId       String
  status           ExecutionStatus @default(pending)
  config           Json?
  result           Json?
  targetCount      Int?
  actualReach      Int?
  actualResponse   Int?
  actualConversion Int?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  scenario         Scenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@map("executions")
}

model Atom {
  id          String     @id @default(uuid())
  name        String
  type        AtomType
  description String?
  successRate Float?
  usageCount  Int        @default(0)
  tags        String[]
  config      Json?
  scenarios   String[]
  status      AtomStatus @default(active)
  version     String     @default("v1.0")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("atoms")
}

model ModelConfig {
  id           String       @id @default(uuid())
  name         String
  provider     String
  apiUrl       String?
  apiKey       String
  modelVersion String
  temperature  Float        @default(0.7)
  maxTokens    Int          @default(4096)
  status       ConfigStatus @default(enabled)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("model_configs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AbTest {
  id          String     @id @default(uuid())
  name        String
  type        String
  description String?
  branches    Json
  metric      String
  status      TestStatus @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("ab_tests")
}

model TaskSchedule {
  id            String                  @id @default(uuid())
  name          String
  scenarioId    String?
  triggerType   String
  triggerConfig Json?
  targetSegment String?
  channels      String[]
  status        ScheduleStatus          @default(active)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  executions    TaskScheduleExecution[]

  @@map("task_schedules")
}

model TaskScheduleExecution {
  id          String       @id @default(uuid())
  scheduleId  String
  status      String       @default("pending")
  triggerType String
  result      Json?
  error       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  schedule    TaskSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("task_schedule_executions")
}

model AlarmRule {
  id        String         @id @default(uuid())
  name      String
  metric    String
  condition String
  threshold Float
  level     String
  enabled   Boolean        @default(true)
  channels  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  history   AlarmHistory[]

  @@map("alarm_rules")
}

model AlarmHistory {
  id             String    @id @default(uuid())
  ruleId         String
  triggeredAt    DateTime  @default(now())
  value          Float
  status         String
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  comments       Json      @default("[]")
  processedAt    DateTime?
  rule           AlarmRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("alarm_history")
}

model Report {
  id          String    @id @default(uuid())
  name        String
  type        String
  format      String
  status      String
  fileId      String?
  config      Json
  generatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("reports")
}

model Workflow {
  id          String              @id @default(uuid())
  name        String
  description String?
  nodes       Json
  edges       Json
  enabled     Boolean             @default(false)
  status      WorkflowStatus      @default(draft)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  executions  WorkflowExecution[]

  @@map("workflows")
}

model WorkflowExecution {
  id          String          @id @default(uuid())
  workflowId  String
  status      ExecutionStatus @default(pending)
  context     Json?
  result      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_executions")
}

model Template {
  id          String         @id @default(uuid())
  name        String
  type        TemplateType
  category    String?
  content     String
  variables   String[]
  description String?
  isSystem    Boolean        @default(false)
  usageCount  Int            @default(0)
  status      TemplateStatus @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("templates")
}

model BatchStrategy {
  id          String      @id @default(uuid())
  name        String
  description String?
  operations  Json
  targetIds   String[]
  status      BatchStatus @default(pending)
  result      Json?
  executedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@map("batch_strategies")
}

model CrmCustomerSync {
  id         String   @id @default(uuid())
  crmId      String   @unique
  name       String
  phone      String?
  idNumber   String?
  lastSyncAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("crm_customer_sync")
}

model AudienceSegment {
  id          String   @id @default(uuid())
  name        String
  description String?
  conditions  Json
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("audience_segments")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  segment   String?
  asset     Float?
  tags      String[]
  createdAt DateTime @default(now())

  @@map("customers")
}

model ForbiddenWord {
  id          String   @id @default(uuid())
  word        String
  category    String
  severity    String   @default("medium")
  replacement String
  enabled     Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("forbidden_words")
}

model ComplianceRule {
  id          String   @id @default(uuid())
  name        String
  description String
  type        String
  enabled     Boolean  @default(true)
  config      Json
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("compliance_rules")
}

model ComplianceCheckLog {
  id             String   @id @default(uuid())
  content        String
  customerRisk   String?
  productRisk    String?
  passed         Boolean
  score          Int
  forbiddenWords Json?
  ruleViolations Json?
  suggestions    Json?
  checkedBy      String?
  createdAt      DateTime @default(now())

  @@map("compliance_check_logs")
}

model Complaint {
  id          String   @id @default(uuid())
  executionId String?
  customerId  String?
  channel     String?
  reason      String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("complaints")
}

model ModelCallLog {
  id               String   @id @default(uuid())
  modelName        String
  provider         String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  responseTime     Int
  success          Boolean
  errorMessage     String?
  agentType        String?
  createdAt        DateTime @default(now())

  @@index([modelName])
  @@index([createdAt])
  @@index([success])
  @@map("model_call_logs")
}

enum UserRole {
  admin
  manager
  operator
  readonly
}

enum UserStatus {
  enabled
  disabled
}

enum ScenarioCategory {
  acquisition
  growth
  mature
  declining
  recovery
}

enum ScenarioStatus {
  draft
  active
  paused
  archived
}

enum ExecutionStatus {
  pending
  running
  completed
  failed
  paused
}

enum AtomType {
  hook
  channel
  content
  risk
}

enum AtomStatus {
  active
  inactive
}

enum ConfigStatus {
  enabled
  disabled
}

enum TestStatus {
  draft
  running
  completed
  paused
}

enum ScheduleStatus {
  active
  paused
  completed
}

enum WorkflowStatus {
  draft
  active
  paused
  archived
}

enum TemplateType {
  sms
  email
  push
  wechat
  call
}

enum TemplateStatus {
  active
  inactive
  archived
}

enum BatchStatus {
  pending
  processing
  completed
  failed
}
